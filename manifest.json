{
  "manifest_version": 3,
  "name": "BidPolish",
  "version": "1.4.0",
  "description": "Fix, rephrase, retone or translate chat messages in place on Freelancer, WhatsApp and Telegram.",
  "permissions": ["storage"],
  "host_permissions": [
    "https://generativelanguage.googleapis.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "options_page": "options.html",
  "content_scripts": [
    {
      "matches": [
        "*://*.freelancer.com/*",
        "*://web.whatsapp.com/*",
        "*://web.telegram.org/*"
      ],
      "js": ["content.js"],
      "run_at": "document_idle",
      "all_frames": true
    }
  ]
}
